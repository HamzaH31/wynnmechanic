def _parse_db_to_list(db: Any) -> List[Dict[str, Any]]:
    if isinstance(db, list):
        return [x for x in db if isinstance(x, dict)]
    if isinstance(db, dict):
        if isinstance(db.get("items"), list):
            return [x for x in db["items"] if isinstance(x, dict)]
        data = db.get("data")
        if isinstance(data, dict) and isinstance(data.get("items"), list):
            return [x for x in data["items"] if isinstance(x, dict)]
        vals = [v for v in db.values() if isinstance(v, dict)]
        if vals:
            return vals
    return []

def normalize_item(raw: Dict[str, Any]) -> Dict[str, Any]:
    name = raw.get("name") or raw.get("internalName") or raw.get("displayName") or "Unknown"
    it_type = str(raw.get("type") or "").lower()
    reqs = raw.get("requirements") or {}
    lvl = int(reqs.get("level") or raw.get("level") or 0)
    class_req = reqs.get("classRequirement")
    ids = raw.get("identifications") or {}
    base = raw.get("base") or {}
    avg_dps = raw.get("averageDps")
    return {
        "name": str(name),
        "type": it_type,
        "attackSpeed": raw.get("attackSpeed"),
        "level": lvl,
        "classRequirement": class_req,
        "identifications": ids,
        "base": base,
        "averageDps": avg_dps,
        "rarity": raw.get("rarity") or raw.get("tier"),
        "raw": raw,
    }

async def ensure_item_index() -> None:
    global ITEM_INDEX, ITEMS_LIST
    if ITEMS_LIST and ITEM_INDEX:
        return
    db = await get_item_database(full_result=True)
    arr = _parse_db_to_list(db)
    items = [normalize_item(x) for x in arr]
    idx = {it["name"].lower(): it for it in items if it.get("name")}
    ITEMS_LIST = items
    ITEM_INDEX = idx

def find_item_by_name(name: Optional[str]) -> Optional[Dict[str, Any]]:
    if not name:
        return None
    return ITEM_INDEX.get(name.lower())

