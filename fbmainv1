def percentile(sorted_vals: List[float], p: float) -> float:
    if not sorted_vals:
        return 0.0
    p = clamp(p, 0.0, 1.0)
    idx = int(round(p * (len(sorted_vals) - 1)))
    return float(sorted_vals[idx])

def gather_items_from_loadout(loadout: Dict[str, Optional[str]]) -> List[Dict[str, Any]]:
    out: List[Dict[str, Any]] = []
    for slot in EQUIP_SLOTS:
        n = loadout.get(slot)
        it = find_item_by_name(n)
        if it:
            out.append(it)
    return out

def roll_build_ids(items: List[Dict[str, Any]], overrides: Dict[str, Dict[str, Any]], rng: random.Random) -> Dict[str, float]:
    total: Dict[str, float] = {}
    for it in items:
        name = it["name"]
        ov = overrides.get(name, {})
        rolled = resolve_ids(it.get("identifications") or {}, rng, ov)
        for k, v in rolled.items():
            total[k] = float(total.get(k, 0.0) + float(v))
    return total

def compute_build_stats_from_ids(ids: Dict[str, float]) -> Dict[str, Any]:
    hp = float(ids.get("rawHealth", 0.0))
    mana_regen = float(ids.get("manaRegen", 0.0))
    mana_steal = float(ids.get("manaSteal", 0.0))
    life_steal = float(ids.get("lifeSteal", 0.0))
    heal_eff = float(ids.get("healingEfficiency", 0.0))
    spell_cost_pct = float(ids.get("spellCost", 0.0))
    raw_1st = float(ids.get("raw1stSpellCost", 0.0))
    defs = {
        "earthDefence": float(ids.get("earthDefence", 0.0)),
        "thunderDefence": float(ids.get("thunderDefence", 0.0)),
        "waterDefence": float(ids.get("waterDefence", 0.0)),
        "fireDefence": float(ids.get("fireDefence", 0.0)),
        "airDefence": float(ids.get("airDefence", 0.0)),
    }
    avg_def = sum(defs.values()) / max(1, len(defs))
    ehp = hp * (1.0 + (avg_def / 200.0))
    sustain = mana_regen * 1.4 + mana_steal * 0.9 + life_steal * 0.4 + heal_eff * 0.05 - spell_cost_pct * 0.2 + (-raw_1st) * 0.15
    return {"effectiveHealth": ehp, "sustainScore": sustain, "spellCostPct": spell_cost_pct}

def compute_spell_midpoint_damage(weapon_item: Dict[str, Any], rolled_ids: Dict[str, float], spell_key: str) -> float:
    atkspd = weapon_item.get("attackSpeed") or "normal"
    base = parse_weapon_base(weapon_item)
    boosts = {
        "strength": 0.0,
        "spell": float(rolled_ids.get("spellDamage", 0.0)),
        "earth": float(rolled_ids.get("earthDamage", 0.0)),
        "thunder": float(rolled_ids.get("thunderDamage", 0.0)),
        "water": float(rolled_ids.get("waterDamage", 0.0)),
        "fire": float(rolled_ids.get("fireDamage", 0.0)),
        "air": float(rolled_ids.get("airDamage", 0.0)),
    }
    elem_spell = float(rolled_ids.get("elementalSpellDamage", 0.0))
    if elem_spell:
        for k in ("earth","thunder","water","fire","air"):
            boosts[k] += elem_spell
    raw_spell = float(rolled_ids.get("rawSpellDamage", 0.0))
    d = ElemDam(base.nmin, base.nmax, base.emin, base.emax, base.tmin, base.tmax, base.wmin, base.wmax, base.fmin, base.fmax, base.amin, base.amax)
    d = apply_spell_conversions(d, spell_key)
    d = apply_id_bonuses_spell(d, boosts)
    d = apply_attack_speed_mult_spell(d, atkspd)
    d = apply_raw_spell(d, raw_spell)
    d = apply_spell_multiplier(d, spell_key)
    mn, mx = total_damage(d)
    return (mn + mx) / 2.0

def simulate_with_tree(payload: SimPayload, tree_json: dict) -> Dict[str, Any]:
    weapon_name = payload.loadout.get("weapon")
    if not weapon_name:
        raise HTTPException(400, "Missing weapon name in loadout.weapon")
    weapon_item = find_item_by_name(weapon_name)
    if not weapon_item:
        raise HTTPException(404, f"Weapon not found in item DB: {weapon_name}")

    items = gather_items_from_loadout(payload.loadout)
    rng = random.Random(int(payload.seed))
    n = max(1, int(payload.nSamples))

    stat_accum: Dict[str, float] = {}
    spell_samples: Dict[str, List[float]] = {s: [] for s in ["aura_center","totem_smash","totem_tick"]}

    for _ in range(n):
        rolled_ids = roll_build_ids(items, payload.itemRollOverrides, rng)
        for k, v in rolled_ids.items():
            stat_accum[k] = float(stat_accum.get(k, 0.0) + float(v))
        for spell in spell_samples.keys():
            spell_samples[spell].append(compute_spell_midpoint_damage(weapon_item, rolled_ids, spell))

    avg_ids = {k: v / n for k, v in stat_accum.items()}
    stats = compute_build_stats_from_ids(avg_ids)

    spell_out = {}
    for k, vals in spell_samples.items():
        vals.sort()
        spell_out[k] = {"p50": percentile(vals, 0.50), "mean": sum(vals)/len(vals)}

    ref_dps = weapon_dps_reference(weapon_item)
    engine = compute_engine_dps(tree_json, payload.selectedNodes, ref_dps, payload.engineKnobs)

    aura_p50 = spell_out["aura_center"]["p50"]
    total_damage = aura_p50 + float(engine["total_engine_dps"])

    mana_sustain = stats["sustainScore"]
    ehp = stats["effectiveHealth"]
    raid_score = clamp((0.0009*total_damage + 0.00025*ehp + 0.03*mana_sustain), 0.0, 100.0)

    analysis = {
        "totalDamage": int(round(total_damage)),
        "effectiveHealth": int(round(ehp)),
        "manaSustain": round(mana_sustain, 1),
        "raidViability": f"{round(raid_score, 1)}%",
        "spellDamage": int(round(aura_p50)),
        "meleeDamage": 0,
        "spellCost": round(stats["spellCostPct"], 1),
        "damageScore": round(total_damage/1000.0, 2),
        "sustainScore": round(mana_sustain/10.0, 2),
        "defenseScore": round(ehp/5000.0, 2),
        "stabilityScore": round((total_damage/1000.0 + mana_sustain/10.0 + ehp/5000.0)/3.0, 2),
        "requirementValidity": "OK",
    }

    return {"summary": {"class": payload.className, "level": payload.level, "weapon": weapon_name, "samples": n},
            "analysis": analysis,
            "details": {"spell": spell_out, "engine": engine, "weaponDpsReference": ref_dps}}

