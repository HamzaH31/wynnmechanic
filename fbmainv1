# Simulate
@app.post("/api/simulate")
async def api_simulate(payload: SimPayload):
    await ensure_item_index()
    class_key = payload.className.lower().strip()
    tree_key = class_key if class_key in {"archer","warrior","mage","assassin","shaman"} else "shaman"
    tree_json = await get_ability_tree(tree_key)
    return JSONResponse(simulate_with_tree(payload, tree_json))
