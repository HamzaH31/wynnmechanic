class ElemDam:
    __slots__ = ("nmin","nmax","emin","emax","tmin","tmax","wmin","wmax","fmin","fmax","amin","amax")
    def __init__(self, nmin=0.0,nmax=0.0, emin=0.0,emax=0.0, tmin=0.0,tmax=0.0,
                 wmin=0.0,wmax=0.0, fmin=0.0,fmax=0.0, amin=0.0,amax=0.0):
        self.nmin=nmin; self.nmax=nmax
        self.emin=emin; self.emax=emax
        self.tmin=tmin; self.tmax=tmax
        self.wmin=wmin; self.wmax=wmax
        self.fmin=fmin; self.fmax=fmax
        self.amin=amin; self.amax=amax

def convert_and_floor(neutral_base: float, neutral: float, pct: float) -> Tuple[float, float]:
    convert = min(neutral, neutral_base * pct)
    elemental = float(int(math.floor(convert)))
    new_neutral = float(int(math.floor(neutral - convert)))
    return new_neutral, elemental

def apply_spell_conversions(d: ElemDam, spell_key: str) -> ElemDam:
    conv = SPELL_CONVERSIONS.get(spell_key, {})
    if not conv:
        return d
    baseN_min, curN_min = d.nmin, d.nmin
    emin,tmin,wmin,fmin,amin = d.emin,d.tmin,d.wmin,d.fmin,d.amin
    for el, pct in conv.items():
        curN_min, amt = convert_and_floor(baseN_min, curN_min, float(pct))
        if el == "earth": emin += amt
        elif el == "thunder": tmin += amt
        elif el == "water": wmin += amt
        elif el == "fire": fmin += amt
        elif el == "air": amin += amt
    baseN_max, curN_max = d.nmax, d.nmax
    emax,tmax,wmax,fmax,amax = d.emax,d.tmax,d.wmax,d.fmax,d.amax
    for el, pct in conv.items():
        curN_max, amt = convert_and_floor(baseN_max, curN_max, float(pct))
        if el == "earth": emax += amt
        elif el == "thunder": tmax += amt
        elif el == "water": wmax += amt
        elif el == "fire": fmax += amt
        elif el == "air": amax += amt
    return ElemDam(curN_min, curN_max, emin, emax, tmin, tmax, wmin, wmax, fmin, fmax, amin, amax)

def apply_id_bonuses_spell(d: ElemDam, boosts_pct: Dict[str, float]) -> ElemDam:
    spell_pct = float(boosts_pct.get("spell", 0.0))
    str_pct = float(boosts_pct.get("strength", 0.0))
    def mult(total_pct: float) -> float:
        total_pct = max(-100.0, total_pct)
        return 1.0 + total_pct / 100.0
    mN = mult(str_pct + spell_pct)
    def mEl(key: str) -> float:
        return mult(str_pct + spell_pct + float(boosts_pct.get(key, 0.0)))
    return ElemDam(
        d.nmin*mN, d.nmax*mN,
        d.emin*mEl("earth"), d.emax*mEl("earth"),
        d.tmin*mEl("thunder"), d.tmax*mEl("thunder"),
        d.wmin*mEl("water"), d.wmax*mEl("water"),
        d.fmin*mEl("fire"), d.fmax*mEl("fire"),
        d.amin*mEl("air"), d.amax*mEl("air"),
    )

def apply_attack_speed_mult_spell(d: ElemDam, attack_speed: str) -> ElemDam:
    m = ATTACK_SPEED_MULT_SPELL.get(attack_speed, 2.05)
    return ElemDam(
        d.nmin*m, d.nmax*m,
        d.emin*m, d.emax*m,
        d.tmin*m, d.tmax*m,
        d.wmin*m, d.wmax*m,
        d.fmin*m, d.fmax*m,
        d.amin*m, d.amax*m,
    )

def apply_raw_spell(d: ElemDam, raw_spell: float) -> ElemDam:
    nmin = d.nmin + raw_spell
    nmax = d.nmax + raw_spell
    total_min = nmin + d.emin + d.tmin + d.wmin + d.fmin + d.amin
    total_max = nmax + d.emax + d.tmax + d.wmax + d.fmax + d.amax
    if total_min < 0 or total_max < 0:
        return ElemDam()
    return ElemDam(nmin, nmax, d.emin, d.emax, d.tmin, d.tmax, d.wmin, d.wmax, d.fmin, d.fmax, d.amin, d.amax)

def apply_spell_multiplier(d: ElemDam, spell_key: str) -> ElemDam:
    pct = SPELL_MULT_PCT.get(spell_key, 100.0)
    m = pct / 100.0
    return ElemDam(
        d.nmin*m, d.nmax*m,
        d.emin*m, d.emax*m,
        d.tmin*m, d.tmax*m,
        d.wmin*m, d.wmax*m,
        d.fmin*m, d.fmax*m,
        d.amin*m, d.amax*m,
    )

def total_damage(d: ElemDam) -> Tuple[float,float]:
    mn = d.nmin + d.emin + d.tmin + d.wmin + d.fmin + d.amin
    mx = d.nmax + d.emax + d.tmax + d.wmax + d.fmax + d.amax
    return mn, mx

def parse_weapon_base(item: Dict[str, Any]) -> ElemDam:
    base = item.get("base") or {}
    def mm(key: str) -> Tuple[float,float]:
        v = base.get(key)
        if isinstance(v, dict) and "min" in v and "max" in v:
            return float(v["min"]), float(v["max"])
        return 0.0, 0.0
    nmn,nmx = mm("baseNeutralDamage")
    emn,emx = mm("baseEarthDamage")
    tmn,tmx = mm("baseThunderDamage")
    wmn,wmx = mm("baseWaterDamage")
    fmn,fmx = mm("baseFireDamage")
    amn,amx = mm("baseAirDamage")
    return ElemDam(nmn,nmx, emn,emx, tmn,tmx, wmn,wmx, fmn,fmx, amn,amx)

