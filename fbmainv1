def strip_html(s: str) -> str:
    return TAG_RE.sub("", s).replace("\u00a0", " ").strip()

def flatten_nodes(tree_json: dict) -> Dict[str, dict]:
    out = {}
    pages = tree_json.get("pages") or {}
    for _, page_nodes in pages.items():
        if isinstance(page_nodes, dict):
            for node_id, node in page_nodes.items():
                out[node_id] = node
    return out

def parse_total_damage_pct(text: str) -> Optional[float]:
    m = re.search(r"Total Damage:\s*([+-]?\d+(?:\.\d+)?)\s*%\s*\(of your DPS\)", text)
    return float(m.group(1)) if m else None

def parse_every_seconds_to_hps(text: str) -> Optional[float]:
    m = re.search(r"every\s*([0-9.]+)s", text)
    if not m:
        return None
    interval = float(m.group(1))
    return (1.0 / interval) if interval > 0 else None

def parse_max_count(text: str, default: int) -> int:
    m = re.search(r"Max\s*([0-9]+)", text)
    return int(m.group(1)) if m else default

def weapon_dps_reference(weapon_item: Dict[str, Any]) -> float:
    raw = weapon_item.get("raw") or {}
    v = raw.get("averageDps", weapon_item.get("averageDps", 0))
    try:
        return float(v or 0.0)
    except Exception:
        return 0.0

def compute_engine_dps(tree_json: dict, selected_nodes: List[str], weapon_ref_dps: float, knobs: Dict[str, Any]) -> Dict[str, Any]:
    sel = set(selected_nodes)
    nodes = flatten_nodes(tree_json)

    def node_text(nid: str) -> str:
        node = nodes.get(nid) or {}
        desc = node.get("description") or []
        return " ".join(strip_html(x) for x in desc)

    engines: Dict[str, Any] = {}
    total = 0.0

    if "puppetMaster" in sel and "puppetMaster" in nodes:
        txt = node_text("puppetMaster")
        td = parse_total_damage_pct(txt) or 0.0
        hps = parse_every_seconds_to_hps(txt) or 0.0
        max_p = parse_max_count(txt, 3)
        if "morePuppets" in sel: max_p += 1
        if "morePuppets2" in sel: max_p += 2
        uptime = float(knobs.get("puppet_uptime", 1.0))
        dps = (weapon_ref_dps * (td/100.0)) * hps * max_p * uptime
        engines["puppets"] = {"dps": dps, "totalDamagePct": td, "hitsPerSecond": hps, "count": max_p, "uptime": uptime}
        total += dps

    if "jungleSlayer" in sel and "jungleSlayer" in nodes:
        txt = node_text("jungleSlayer")
        td = parse_total_damage_pct(txt) or 0.0
        hps = parse_every_seconds_to_hps(txt) or 0.0
        active_totems = max(1, int(knobs.get("active_totems", 1)))
        effigy_mult = 0.8 ** (active_totems - 1)
        uptime = float(knobs.get("effigy_uptime", 1.0))
        dps = (weapon_ref_dps * (td/100.0)) * hps * active_totems * uptime * effigy_mult
        engines["effigy"] = {"dps": dps, "totalDamagePct": td, "hitsPerSecond": hps, "count": active_totems, "uptime": uptime, "multiplier": effigy_mult}
        total += dps

    if "hummingbirds" in sel and "hummingbirds" in nodes:
        txt = node_text("hummingbirds")
        td = parse_total_damage_pct(txt) or 0.0
        hps = parse_every_seconds_to_hps(txt) or 0.0
        count = 2
        uptime = float(knobs.get("hummingbird_uptime", 1.0))
        dps = (weapon_ref_dps * (td/100.0)) * hps * count * uptime
        engines["hummingbirds"] = {"dps": dps, "totalDamagePct": td, "hitsPerSecond": hps, "count": count, "uptime": uptime}
        total += dps

    return {"engines": engines, "total_engine_dps": total}

