def as_minmax(v: Any) -> Optional[Tuple[float, float]]:
    if isinstance(v, (int, float)):
        x = float(v)
        return x, x
    if isinstance(v, dict):
        if "min" in v and "max" in v:
            return float(v["min"]), float(v["max"])
        if "value" in v:
            x = float(v["value"])
            return x, x
        if "raw" in v:
            x = float(v["raw"])
            return x, x
    return None

def clamp(x: float, a: float, b: float) -> float:
    return max(a, min(b, x))

def interp(minv: float, maxv: float, pct: float) -> float:
    p = clamp(float(pct), 0.0, 100.0) / 100.0
    return minv + (maxv - minv) * p

def sample_id_value(v: Any, rng: random.Random) -> float:
    mm = as_minmax(v)
    if not mm:
        return 0.0
    a, b = mm
    if a == b:
        return a
    if ROLL_DISCRETE_INTEGERS:
        lo = math.floor(min(a, b))
        hi = math.floor(max(a, b))
        if hi <= lo:
            return float(lo)
        return float(rng.randint(lo, hi))
    return float(rng.uniform(a, b))

def resolve_ids(ids: Dict[str, Any], rng: random.Random, overrides: Dict[str, Any]) -> Dict[str, float]:
    out: Dict[str, float] = {}
    roll_pct = overrides.get("_rollPct", None)
    for k, v in (ids or {}).items():
        if k in overrides:
            try:
                out[k] = float(overrides[k])
                continue
            except Exception:
                pass
        mm = as_minmax(v)
        if mm and roll_pct is not None:
            a, b = mm
            out[k] = float(interp(a, b, float(roll_pct)))
        else:
            out[k] = float(sample_id_value(v, rng))
    return out

