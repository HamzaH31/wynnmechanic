class BitCursor:
    def __init__(self, data_chars: str):
        # convert each char -> 6-bit value, then store bits LSB-first
        self.bits: List[int] = []
        table = {ch: i for i, ch in enumerate(WB_B64)}
        for ch in data_chars:
            if ch not in table:
                raise HTTPException(400, f"Invalid character in hash: {ch!r}")
            v = table[ch]
            for k in range(6):
                self.bits.append((v >> k) & 1)  # LSB-first
        self.i = 0

    def read_u(self, nbits: int) -> int:
        if self.i + nbits > len(self.bits):
            raise HTTPException(400, "Hash ended early (not enough bits)")
        val = 0
        for k in range(nbits):
            val |= (self.bits[self.i + k] << k)  # LSB-first integer
        self.i += nbits
        return val

    def read_s_twos(self, nbits: int) -> int:
        u = self.read_u(nbits)
        sign_bit = 1 << (nbits - 1)
        if u & sign_bit:
            u = u - (1 << nbits)
        return int(u)

    def remaining_bits(self) -> int:
        return len(self.bits) - self.i

async def wb_get_version_data(version_str: str) -> Dict[str, Any]:
    """
    Loads:
      /data/<version>/encoding_consts.json
      /data/<version>/items.json
      /data/<version>/tomes.json
      /data/<version>/aspects.json
    from the wynnbuilder hosted site (same content as GitHub data folder). :contentReference[oaicite:6]{index=6}
    """
    cache_key = f"wbdata:{version_str}"
    cached = CACHE.get(cache_key)
    if cached is not None:
        return cached

    base = f"https://wynnbuilder.github.io/data/{version_str}"
    enc = await fetch_json(f"{base}/encoding_consts.json")
    items = await fetch_json(f"{base}/items.json")
    tomes = await fetch_json(f"{base}/tomes.json")
    aspects = await fetch_json(f"{base}/aspects.json")

    # Build id->name maps
    id_to_item: Dict[int, str] = {}
    for it in items:
        # items.json has "id" and "displayName"/"name" in this repo’s data
        iid = it.get("id")
        if iid is None:
            continue
        nm = it.get("displayName") or it.get("name")
        if nm:
            id_to_item[int(iid)] = str(nm)

    id_to_tome: Dict[int, str] = {}
    for t in tomes:
        tid = t.get("id")
        nm = t.get("name") or t.get("displayName")
        if tid is not None and nm:
            id_to_tome[int(tid)] = str(nm)

    id_to_aspect: Dict[int, str] = {}
    for a in aspects:
        aid = a.get("id")
        nm = a.get("name") or a.get("displayName")
        if aid is not None and nm:
            id_to_aspect[int(aid)] = str(nm)

    out = {"ENC": enc, "id_to_item": id_to_item, "id_to_tome": id_to_tome, "id_to_aspect": id_to_aspect}
    CACHE.set(cache_key, TTL_WB_DATA, out)
    return out

def decode_powders(cur: BitCursor, ENC: dict) -> List[str]:
    """
    Implements powder decoding per spec summary in ENCODING.md. :contentReference[oaicite:7]{index=7}
    Returns powder strings like "E6", "T4".
    """
    elements: List[str] = ENC["POWDER_ELEMENTS"]
    tiers: int = int(ENC["POWDER_TIERS"])
    pid_bits: int = int(ENC["POWDER_ID_BITLEN"])
    wrap_bits: int = int(ENC["POWDER_WRAPPER_BITLEN"])

    rep_bit = int(ENC["POWDER_REPEAT_OP"]["BITLEN"])
    rep_tier_bit = int(ENC["POWDER_REPEAT_TIER_OP"]["BITLEN"])
    change_bit = int(ENC["POWDER_CHANGE_OP"]["BITLEN"])

    # first powder id
    pid = cur.read_u(pid_bits)
    out: List[Tuple[int, int]] = []  # (element_idx, tier1based)
    el = pid // tiers
    tier = (pid % tiers) + 1
    out.append((el, tier))

    while True:
        repeat_flag = cur.read_u(rep_bit)  # 0 repeat, 1 no_repeat
        if repeat_flag == ENC["POWDER_REPEAT_OP"]["REPEAT"]:
            out.append((el, tier))
            continue

        # NO_REPEAT
        tierop = cur.read_u(rep_tier_bit)  # 0 repeat_tier, 1 change_powder
        if tierop == ENC["POWDER_REPEAT_TIER_OP"]["REPEAT_TIER"]:
            wrap = cur.read_u(wrap_bits)
            # element_wrap is encoded as ((next - curr) % NUM_ELEM) - 1
            # so next = (curr + wrap + 1) % NUM_ELEM
            el = (el + wrap + 1) % len(elements)
            out.append((el, tier))
        else:
            # CHANGE_POWDER -> either NEW_POWDER or NEW_ITEM
            ch = cur.read_u(change_bit)
            if ch == ENC["POWDER_CHANGE_OP"]["NEW_ITEM"]:
                break
            # NEW_POWDER: read a new pid
            pid = cur.read_u(pid_bits)
            el = pid // tiers
            tier = (pid % tiers) + 1
            out.append((el, tier))

    # Convert to "E6" etc
    return [f"{elements[e]}{t}" for (e, t) in out]

async def decode_wynnbuilder_hash(hash_str: str) -> Dict[str, Any]:
    """
    Binary decoding:
      first 6 bits: legacy selector (must be > 11 to be binary) :contentReference[oaicite:8]{index=8}
      next 10 bits: version id -> wynn_version_names :contentReference[oaicite:9]{index=9}
      then parse using encoding_consts.json :contentReference[oaicite:10]{index=10}
    """
    cur = BitCursor(hash_str)

    legacy = cur.read_u(6)
    if legacy <= 11:
        raise HTTPException(400, "This is a legacy WynnBuilder link (old format). Binary import supports modern links; legacy can be added later.")

    version_id = cur.read_u(10)
    if version_id < 0 or version_id >= len(WYNN_VERSION_NAMES):
        # fallback to latest
        version_id = WYNN_VERSION_LATEST
    version_str = WYNN_VERSION_NAMES[version_id]

    vdata = await wb_get_version_data(version_str)
    ENC = vdata["ENC"]
    id_to_item = vdata["id_to_item"]
    id_to_tome = vdata["id_to_tome"]
    id_to_aspect = vdata["id_to_aspect"]

    # Equipment
    equip_kind_bits = int(ENC["EQUIPMENT_KIND"]["BITLEN"])
    item_id_bits = int(ENC["ITEM_ID_BITLEN"])
    powders_flag_bits = int(ENC["EQUIPMENT_POWDERS_FLAG"]["BITLEN"])
    equip_num = int(ENC["EQUIPMENT_NUM"])
    powderable_num = int(ENC["POWDERABLE_EQUIPMENT_NUM"])

    equipment_ids: List[int] = []
    equipment_powders: List[List[str]] = [[] for _ in range(equip_num)]

    for i in range(equip_num):
        kind = cur.read_u(equip_kind_bits)
        if kind != ENC["EQUIPMENT_KIND"]["NORMAL"]:
            raise HTTPException(400, "This build uses crafted/custom items. Importer currently supports NORMAL items only (most builds).")

        enc_id = cur.read_u(item_id_bits)
        # stored as ID+1, where 0 means empty slot
        item_id = int(enc_id) - 1
        if item_id < 0:
            item_id = -1
        equipment_ids.append(item_id)

        if i < powderable_num:
            pf = cur.read_u(powders_flag_bits)
            if pf == ENC["EQUIPMENT_POWDERS_FLAG"]["HAS_POWDERS"]:
                equipment_powders[i] = decode_powders(cur, ENC)

    # Tomes
    tomes: List[str] = []
    if cur.read_u(int(ENC["TOMES_FLAG"]["BITLEN"])) == ENC["TOMES_FLAG"]["HAS_TOMES"]:
        slot_bits = int(ENC["TOME_SLOT_FLAG"]["BITLEN"])
        tome_id_bits = int(ENC["TOME_ID_BITLEN"])
        for _ in range(int(ENC["TOME_NUM"])):
            used = cur.read_u(slot_bits)
            if used == ENC["TOME_SLOT_FLAG"]["USED"]:
                tid = cur.read_u(tome_id_bits)
                tomes.append(id_to_tome.get(int(tid), f"Tome#{tid}"))

    # Skillpoints
    sp = {"str": None, "dex": None, "int": None, "def": None, "agi": None}
    sp_flag = cur.read_u(int(ENC["SP_FLAG"]["BITLEN"]))
    if sp_flag == ENC["SP_FLAG"]["ASSIGNED"]:
        elem_flag_bits = int(ENC["SP_ELEMENT_FLAG"]["BITLEN"])
        sp_val_bits = int(ENC["MAX_SP_BITLEN"])
        order = ["str","dex","int","def","agi"]  # matches builder ordering
        for key in order:
            ef = cur.read_u(elem_flag_bits)
            if ef == ENC["SP_ELEMENT_FLAG"]["ELEMENT_ASSIGNED"]:
                sp[key] = cur.read_s_twos(sp_val_bits)
            else:
                sp[key] = None

    # Level
    lvl_flag = cur.read_u(int(ENC["LEVEL_FLAG"]["BITLEN"]))
    if lvl_flag == ENC["LEVEL_FLAG"]["MAX"]:
        level = int(ENC["MAX_LEVEL"])
    else:
        level = int(cur.read_u(int(ENC["LEVEL_BITLEN"])))

    # Aspects (plus tiers)
    aspects_out: List[Dict[str, Any]] = []
    if cur.read_u(int(ENC["ASPECTS_FLAG"]["BITLEN"])) == ENC["ASPECTS_FLAG"]["HAS_ASPECTS"]:
        slot_bits = int(ENC["ASPECT_SLOT_FLAG"]["BITLEN"])
        asp_id_bits = int(ENC["ASPECT_ID_BITLEN"])
        tier_bits = int(ENC.get("ASPECT_TIER_BITLEN", 0) or 0)
        num_aspects = int(ENC.get("NUM_ASPECTS", 0) or 0)
        for _ in range(num_aspects):
            used = cur.read_u(slot_bits)
            if used == ENC["ASPECT_SLOT_FLAG"]["USED"]:
                aid = int(cur.read_u(asp_id_bits))
                tier = int(cur.read_u(tier_bits)) if tier_bits > 0 else 0
                aspects_out.append({"name": id_to_aspect.get(aid, f"Aspect#{aid}"), "tierIndex": tier})

    # Ability tree blob = remaining bits
    ability_tree_bits_remaining = cur.remaining_bits()

    # Map equip IDs to names
    loadout: Dict[str, Optional[str]] = {}
    for slot, iid in zip(EQUIP_SLOTS, equipment_ids):
        if iid < 0:
            loadout[slot] = None
        else:
            loadout[slot] = id_to_item.get(iid, f"Item#{iid}")

    return {
        "version": version_str,
        "level": level,
        "loadout": loadout,
        "powders": {slot: equipment_powders[i] for i, slot in enumerate(EQUIP_SLOTS) if i < len(equipment_powders) and equipment_powders[i]},
        "tomes": tomes,
        "skillpoints": sp,
        "aspects": aspects_out,
        "abilityTreeBitsRemaining": ability_tree_bits_remaining,
        "note": "Imported via WynnBuilder binary encoding (normal items only). Legacy/crafted/custom can be added later."
    }

